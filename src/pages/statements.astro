---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
import { url } from "../lib/url";
---

<BaseLayout
  title="Problem statements"
  description="All nine CH4114 standardised problem statements in one place."
  active="statements"
>
  <section class="hero wrap" style="padding-bottom:1rem">
    <span class="hero-annot" style="right:9%;top:7rem;transform:rotate(6deg)">verbatim ✎</span>
    <h1 style="text-align:left">All nine<br /><em>problem statements</em></h1>
    <p class="hero-sub" style="text-align:left;margin-left:0">
      Exactly as agreed in the research register — the proposed objective, the
      simulation system, the analysis plan and the advanced challenge for every
      project in the group.
    </p>
  </section>

  <section class="sec" style="padding-top:2.5rem">
    <div class="wrap">
      <div class="paper-panel" style="margin-bottom:1rem">
        <span class="role" style="display:block;font-family:var(--font-mono);font-size:.6rem;letter-spacing:.18em;text-transform:uppercase;color:var(--body);margin-bottom:.9rem">Index</span>
        <ul class="toc">
          {projects.map((p) => (
            <li>
              <a href={`#${p.roll}`}><span class="r">{p.roll}</span>{p.short}</a>
            </li>
          ))}
        </ul>
      </div>

      {projects.map((p) => (
        <article class="stmt" id={p.roll}>
          <div class="roll" style="font-family:var(--font-mono);font-size:.72rem;letter-spacing:.14em;color:var(--coral)">{p.roll}</div>
          <h3>{p.title}</h3>
          <div class="kicker" style="font-family:var(--font-mono);font-size:.66rem;letter-spacing:.16em;text-transform:uppercase;color:var(--body);margin-top:.45rem">
            {p.domain}
          </div>
          <blockquote>{p.problemStatement}</blockquote>
          <p style="margin-top:1.1rem;font-family:var(--font-mono);font-size:.72rem;letter-spacing:.06em">
            <a href={url(`projects/${p.slug}/`)}>full project →</a>
            &nbsp;·&nbsp;
            <a href={p.repo} target="_blank" rel="noopener">repository ↗</a>
          </p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
